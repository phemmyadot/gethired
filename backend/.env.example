# Database
DATABASE_URL=postgresql://jobbot:jobbot@localhost/jobbot

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Job APIs
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Applicant info (used in auto-apply forms)
