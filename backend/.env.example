APPLICANT_PHONE=+15555555555
APPLICANT_CURRENT_COMPANY=Previous Corp
APPLICANT_LINKEDIN=https://linkedin.com/in/janesmith

# Resume storage
RESUME_UPLOAD_DIR=/tmp/jobbot_resumes
