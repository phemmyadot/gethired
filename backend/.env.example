# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# LLM provider
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=your-model-name
LOCAL_LLM_TIMEOUT=120

# Anthropic fallback (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=600

# Job APIs
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Applicant info
APPLICANT_FIRST_NAME=your_first_name
APPLICANT_LAST_NAME=your_last_name
APPLICANT_EMAIL=your_email@example.com
APPLICANT_PHONE=+15551234567
APPLICANT_CURRENT_COMPANY=your_current_company
APPLICANT_LINKEDIN=https://linkedin.com/in/your-profile

# Resume storage
RESUME_UPLOAD_DIR=/tmp/jobbot_resumes

# Feature flags
AUTO_APPLY_ENABLED=false
GREENHOUSE_ENABLED=false
LEVER_ENABLED=false
ASHBY_ENABLED=true

# Comma-separated ATS board tokens (only used if the source above is enabled).
# Greenhouse/Lever/Ashby company lists also grow automatically via dynamic
# discovery — see discovered_ats_companies table / ATS_DISCOVERY_PROBE_CAP.
GREENHOUSE_COMPANY_TOKENS=stripe,airbnb,figma
LEVER_COMPANY_TOKENS=netflix,reddit,canva
ASHBY_COMPANY_TOKENS=

# New companies probed per ATS source per ingestion run, for dynamic discovery
ATS_DISCOVERY_PROBE_CAP=10
